# Private harness — never ship with the public repo.
# Worktrees receive these via symlinks (see .claude/hooks/worktree-create.sh).
# Bare names (no trailing slash) are listed alongside dir patterns so the
# rules also match the SYMLINKS worktrees contain (V-001).
.claude
.claude/
rules
rules/
CLAUDE.md
SPEC.md

# Worktrees
.worktrees/

# Artifacts
artifacts
artifacts/*

# Dependencies
node_modules/

# Wrangler local state + build output
.wrangler/
dist/

# Secrets — never commit. Keep only the .example template.
.dev.vars
.dev.vars.*
!.dev.vars.example
